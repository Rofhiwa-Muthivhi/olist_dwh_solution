    <DTS:Executable
      DTS:refId="Package\05_ensure_etl_load_log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7F868FD3-F525-4917-890C-11C98E77033D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05_ensure_etl_load_log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{588E6981-183D-41DE-B56E-4B5CD1F797C5}"
          SQLTask:SqlStatementSource="IF SCHEMA_ID('etl') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA etl');&#xA;END;&#xA;&#xA;IF OBJECT_ID('etl.load_log', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE etl.load_log&#xA;    (&#xA;        load_log_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        batch_id INT NOT NULL,&#xA;        source_file NVARCHAR(260) NOT NULL,&#xA;        rows_loaded INT NOT NULL,&#xA;        load_status NVARCHAR(20) NOT NULL,&#xA;        load_timestamp DATETIME2 NOT NULL DEFAULT SYSDATETIME()&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\06_generate_batch_id"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7C52B9C4-8B35-4124-920C-97B644CFE464}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="06_generate_batch_id"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{588E6981-183D-41DE-B56E-4B5CD1F797C5}"
          SQLTask:SqlStatementSource="USE [olist_stg];&#xA;&#xA;-- i am creating the etl schema if it does not exist&#xA;IF SCHEMA_ID('etl') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA etl');&#xA;END;&#xA;&#xA;-- i am creating the batch id sequence if it does not exist&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.sequences&#xA;    WHERE name = 'batch_id_seq'&#xA;      AND SCHEMA_NAME(schema_id) = 'etl'&#xA;)&#xA;BEGIN&#xA;    CREATE SEQUENCE etl.batch_id_seq&#xA;        AS BIGINT&#xA;        START WITH 1&#xA;        INCREMENT BY 1;&#xA;END;&#xA;&#xA;-- i am generating the next batch id for this ingestion run&#xA;SELECT NEXT VALUE FOR etl.batch_id_seq AS BatchID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
