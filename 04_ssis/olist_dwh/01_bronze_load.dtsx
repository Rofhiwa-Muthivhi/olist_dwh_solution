      DTS:refId="Package\04_ensure_etl_load_log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7F868FD3-F525-4917-890C-11C98E77033D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04_ensure_etl_load_log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{588E6981-183D-41DE-B56E-4B5CD1F797C5}"
          SQLTask:SqlStatementSource="IF SCHEMA_ID('etl') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA etl');&#xA;END;&#xA;&#xA;IF OBJECT_ID('etl.load_log', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE etl.load_log&#xA;    (&#xA;        load_log_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        batch_id INT NOT NULL,&#xA;        source_file NVARCHAR(260) NOT NULL,&#xA;        rows_loaded INT NOT NULL,&#xA;        load_status NVARCHAR(20) NOT NULL,&#xA;        load_timestamp DATETIME2 NOT NULL DEFAULT SYSDATETIME()&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
