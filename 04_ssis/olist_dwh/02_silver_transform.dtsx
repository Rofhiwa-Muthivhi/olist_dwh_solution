    <DTS:Executable
      DTS:refId="Package\26_prepare_silver_tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9FED12EE-4265-41D8-974D-F449ED92D833}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="26_prepare_silver_tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;-- i am clearing the silver tables before a fresh transformation run&#xA;TRUNCATE TABLE silver.customers;&#xA;TRUNCATE TABLE silver.sellers;&#xA;TRUNCATE TABLE silver.orders;&#xA;TRUNCATE TABLE silver.order_items;&#xA;TRUNCATE TABLE silver.order_payments;&#xA;TRUNCATE TABLE silver.order_reviews;&#xA;TRUNCATE TABLE silver.products;&#xA;TRUNCATE TABLE silver.geolocation;&#xA;TRUNCATE TABLE silver.product_category_name_translation;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\27_create_clean_customer_view"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1FC93B3D-AD29-4E13-9EA6-DAA3DC6CC322}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="27_create_clean_customer_view"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="CREATE OR ALTER VIEW silver.vw_customers_prepared&#xA;AS&#xA;SELECT&#xA;    customer_id,&#xA;    customer_unique_id,&#xA;&#xA;    -- i am trimming and padding the zip prefix to 5 characters&#xA;    CAST(&#xA;        RIGHT(&#xA;            '00000' + LTRIM(RTRIM(customer_zip_code_prefix)),&#xA;            5&#xA;        )&#xA;        AS CHAR(5)&#xA;    ) AS customer_zip_code_prefix,&#xA;&#xA;    -- i am removing unwanted spaces from the city and state&#xA;    LTRIM(RTRIM(customer_city)) AS customer_city,&#xA;    LTRIM(RTRIM(customer_state)) AS customer_state,&#xA;&#xA;    dwh_load_ts,&#xA;    dwh_source_file,&#xA;    dwh_batch_id&#xA;&#xA;FROM olist_stg.bronze.customers;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
