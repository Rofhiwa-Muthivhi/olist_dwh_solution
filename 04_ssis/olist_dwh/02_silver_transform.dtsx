      DTS:ObjectName="33_create_clean_order_items_view"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="-- i am creating a preparation view for the order items data before loading it into the silver layer&#xA;CREATE OR ALTER VIEW silver.vw_order_items_prepared&#xA;AS&#xA;SELECT&#xA;    order_id,&#xA;    order_item_id,&#xA;    product_id,&#xA;    seller_id,&#xA;&#xA;    -- i am converting shipping_limit_date to DATETIME2 for consistent date and time handling&#xA;    CAST(shipping_limit_date AS DATETIME2) AS shipping_limit_date,&#xA;&#xA;    -- i am converting price and freight_value to DECIMAL(10,2) to ensure consistent monetary precision&#xA;    CAST(price AS DECIMAL(10,2)) AS price,&#xA;    CAST(freight_value AS DECIMAL(10,2)) AS freight_value,&#xA;&#xA;    -- i am preserving the ETL metadata for data lineage and auditing&#xA;    dwh_load_ts,&#xA;    dwh_source_file,&#xA;    dwh_batch_id&#xA;&#xA;-- i am retrieving the original records from the bronze layer without modifying the source data&#xA;FROM olist_stg.bronze.order_items;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
