      DTS:DTSID="{6197317E-8950-4592-B7E0-FF2362F891BB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="29_create_clean_sellers_view"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="-- i am creating or updating the prepared sellers view&#xA;&#xA;CREATE OR ALTER VIEW silver.vw_sellers_prepared&#xA;AS&#xA;SELECT&#xA;    seller_id,&#xA;&#xA;    -- i am trimming and padding zip prefixes to five characters&#xA;    CAST(&#xA;        RIGHT(&#xA;            '00000' + LTRIM(RTRIM(seller_zip_code_prefix)),&#xA;            5&#xA;        )&#xA;        AS CHAR(5)&#xA;    ) AS seller_zip_code_prefix,&#xA;&#xA;    -- i am removing unnecessary spaces from city and state&#xA;    LTRIM(RTRIM(seller_city)) AS seller_city,&#xA;    LTRIM(RTRIM(seller_state)) AS seller_state,&#xA;&#xA;    -- i am retaining source metadata&#xA;    dwh_load_ts,&#xA;    dwh_source_file,&#xA;    dwh_batch_id&#xA;&#xA;FROM olist_stg.bronze.sellers;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
