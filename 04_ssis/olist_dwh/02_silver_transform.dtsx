    <DTS:Executable
      DTS:refId="Package\31_create_clean_orders_view"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{066CD633-CE88-4839-80B4-C2D05F366351}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="31_create_clean_orders_view"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="-- i am creating or updating the prepared orders view&#xA;&#xA;CREATE OR ALTER VIEW silver.vw_orders_prepared&#xA;AS&#xA;SELECT&#xA;    order_id,&#xA;    customer_id,&#xA;    LOWER(LTRIM(RTRIM(order_status))) AS order_status,&#xA;&#xA;    CAST(order_purchase_timestamp AS DATETIME2) AS order_purchase_timestamp,&#xA;    CAST(order_approved_at AS DATETIME2) AS order_approved_at,&#xA;    CAST(order_delivered_carrier_date AS DATETIME2) AS order_delivered_carrier_date,&#xA;    CAST(order_delivered_customer_date AS DATETIME2) AS order_delivered_customer_date,&#xA;    CAST(order_estimated_delivery_date AS DATETIME2) AS order_estimated_delivery_date,&#xA;&#xA;    CAST(&#xA;        CASE&#xA;            WHEN LOWER(LTRIM(RTRIM(order_status))) = 'delivered'&#xA;            THEN 1&#xA;            ELSE 0&#xA;        END AS BIT&#xA;    ) AS is_delivered,&#xA;&#xA;    dwh_load_ts,&#xA;    dwh_source_file,&#xA;    dwh_batch_id&#xA;&#xA;FROM olist_stg.bronze.orders;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
