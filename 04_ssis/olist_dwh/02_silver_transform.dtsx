        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;-- i am clearing the silver tables before a fresh transformation run&#xA;TRUNCATE TABLE silver.customers;&#xA;TRUNCATE TABLE silver.sellers;&#xA;TRUNCATE TABLE silver.orders;&#xA;TRUNCATE TABLE silver.order_items;&#xA;TRUNCATE TABLE silver.order_payments;&#xA;TRUNCATE TABLE silver.order_reviews;&#xA;TRUNCATE TABLE silver.products;&#xA;TRUNCATE TABLE silver.geolocation;&#xA;TRUNCATE TABLE silver.product_category_name_translation;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
