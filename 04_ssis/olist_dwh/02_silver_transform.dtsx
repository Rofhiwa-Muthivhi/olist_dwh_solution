    <DTS:Executable
      DTS:refId="Package\35_create_clean_order_payments_view"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7C65BB23-7F43-42F8-AE8E-D3E5F48C11A9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="35_create_clean_order_payments_view"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="-- i am creating a preparation view for order payments before loading into the silver layer&#xA;CREATE OR ALTER VIEW silver.vw_order_payments_prepared&#xA;AS&#xA;SELECT&#xA;    order_id,&#xA;&#xA;    -- i am converting payment_sequential and payment_installments to INT&#xA;    CAST(payment_sequential AS INT) AS payment_sequential,&#xA;&#xA;    -- i am standardising payment_type by replacing not_defined with Unknown&#xA;    CASE&#xA;        WHEN LOWER(LTRIM(RTRIM(payment_type))) = 'not_defined'&#xA;        THEN 'Unknown'&#xA;        ELSE LTRIM(RTRIM(payment_type))&#xA;    END AS payment_type,&#xA;&#xA;    CAST(payment_installments AS INT) AS payment_installments,&#xA;&#xA;    -- i am converting payment_value to DECIMAL(10,2)&#xA;    CAST(payment_value AS DECIMAL(10,2)) AS payment_value,&#xA;&#xA;    -- i am preserving ETL metadata for data lineage and auditing&#xA;    dwh_load_ts,&#xA;    dwh_source_file,&#xA;    dwh_batch_id&#xA;&#xA;-- i am retrieving the original records without modifying the bronze layer&#xA;FROM olist_stg.bronze.order_payments;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
