    <DTS:Executable
      DTS:refId="Package\37_create_clean_order_reviews"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3D065725-2543-484B-9643-70D0A61D14AC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="37_create_clean_order_reviews"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="&#xA;-- i am creating the preparation view for order reviews before loading into silver&#xA;CREATE OR ALTER VIEW silver.vw_order_reviews_prepared&#xA;AS&#xA;&#xA;-- i am ranking review records to retain only the latest record for each review_id&#xA;WITH ranked_reviews AS&#xA;(&#xA;    SELECT&#xA;        *,&#xA;        ROW_NUMBER() OVER&#xA;        (&#xA;            PARTITION BY review_id&#xA;            ORDER BY&#xA;                review_answer_timestamp DESC,&#xA;                order_id ASC&#xA;        ) AS row_num&#xA;    FROM olist_stg.bronze.order_reviews&#xA;)&#xA;&#xA;SELECT&#xA;    review_id,&#xA;    order_id,&#xA;&#xA;    -- i am converting review_score to TINYINT&#xA;    CAST(review_score AS TINYINT) AS review_score,&#xA;&#xA;    -- i am preserving customer comments as NVARCHAR(MAX)&#xA;    CAST(review_comment_title AS NVARCHAR(MAX)) AS review_comment_title,&#xA;    CAST(review_comment_message AS NVARCHAR(MAX)) AS review_comment_message,&#xA;&#xA;    -- i am converting review timestamps to DATETIME2&#xA;    CAST(review_creation_date AS DATETIME2) AS review_creation_date,&#xA;    CAST(review_answer_timestamp AS DATETIME2) AS review_answer_timestamp,&#xA;&#xA;    -- i am preserving ETL metadata for lineage and auditing&#xA;    dwh_load_ts,&#xA;    dwh_source_file,&#xA;    dwh_batch_id&#xA;&#xA;FROM ranked_reviews&#xA;WHERE row_num = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
