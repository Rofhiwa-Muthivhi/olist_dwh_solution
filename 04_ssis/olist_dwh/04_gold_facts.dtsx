            <component
              refId="Package\60_load_fact_sales\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    -- Order and item identifiers
    oi.order_id,
    oi.order_item_id,

    -- Business keys for dimension lookups
    oi.product_id,
    oi.seller_id,

    -- Customer surrogate key (SCD Type 2 temporal lookup)
    COALESCE(dc.customer_key, -1) AS customer_key,

    -- Order information (Unicode data type for SSIS lookup)
    CAST(o.order_status AS NVARCHAR(50)) AS order_status,
    o.order_purchase_timestamp,

    -- Date-only column for the Date Dimension lookup
    CAST(o.order_purchase_timestamp AS DATE) AS order_purchase_date,

    -- Delivery dates
    dates.order_delivered_customer_date,
    dates.order_estimated_delivery_date,

    -- Sales measures
    oi.price,
    oi.freight_value,
    oi.total_item_value,

    -- Derived business measures
    CASE
        WHEN dates.order_delivered_customer_date IS NOT NULL
        THEN DATEDIFF(
            DAY,
            o.order_purchase_timestamp,
            dates.order_delivered_customer_date
        )
        ELSE NULL
    END AS days_to_deliver,

    CASE
        WHEN dates.order_delivered_customer_date IS NOT NULL
             AND dates.order_estimated_delivery_date IS NOT NULL
        THEN DATEDIFF(
            DAY,
            dates.order_estimated_delivery_date,
            dates.order_delivered_customer_date
        )
        ELSE NULL
    END AS delivery_delay_days,

    CASE
        WHEN dates.order_delivered_customer_date IS NULL
             OR dates.order_estimated_delivery_date IS NULL
        THEN NULL

        WHEN dates.order_delivered_customer_date &gt;
             dates.order_estimated_delivery_date
        THEN CAST(1 AS BIT)

        ELSE CAST(0 AS BIT)
    END AS is_late

FROM silver.order_items oi

INNER JOIN silver.orders o
    ON oi.order_id = o.order_id

INNER JOIN silver.customers c
    ON o.customer_id = c.customer_id

-- Normalise the missing delivery dates
CROSS APPLY
(
    SELECT
        CASE
            WHEN o.order_delivered_customer_date =
                 CONVERT(DATETIME2, '19000101')
            THEN NULL
            ELSE o.order_delivered_customer_date
        END AS order_delivered_customer_date,

        CASE
            WHEN o.order_estimated_delivery_date =
                 CONVERT(DATETIME2, '19000101')
            THEN NULL
            ELSE o.order_estimated_delivery_date
        END AS order_estimated_delivery_date
) dates

-- Match the customer to the correct historical dimension version
LEFT JOIN gold.dim_customer dc
    ON c.customer_unique_id = dc.customer_unique_id

    AND o.order_purchase_timestamp &gt;= dc.valid_from

    AND (
        o.order_purchase_timestamp &lt; dc.valid_to
        OR dc.valid_to IS NULL
    )

WHERE oi.order_id IS NOT NULL;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
