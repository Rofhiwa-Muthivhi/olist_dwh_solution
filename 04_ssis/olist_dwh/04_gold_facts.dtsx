            <component
              refId="Package\64_load_fact_payments\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p.order_id,
    p.payment_sequential,

    c.customer_unique_id,

    -- i am retrieving the correct historical customer key
    COALESCE(dc.customer_key, -1) AS customer_key,

    -- i am extracting the order purchase date for the date lookup
    CAST(o.order_purchase_timestamp AS DATE) AS order_purchase_date,

    -- i am matching the payment type datatype to the gold dimension
    CAST(p.payment_type AS VARCHAR(50)) AS payment_type,

    p.payment_installments,
    p.payment_value

FROM [silver].[order_payments] p

INNER JOIN [silver].[orders] o
    ON p.order_id = o.order_id

INNER JOIN [silver].[customers] c
    ON o.customer_id = c.customer_id

-- i am retrieving the customer version valid when the order was purchased
LEFT JOIN [gold].[dim_customer] dc
    ON c.customer_unique_id = dc.customer_unique_id
    AND o.order_purchase_timestamp &gt;= dc.valid_from
    AND (
        o.order_purchase_timestamp &lt; dc.valid_to
        OR dc.valid_to IS NULL
    );</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
