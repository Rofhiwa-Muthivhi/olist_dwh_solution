    <DTS:Executable
      DTS:refId="Package\61_create_fact_reviews"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7AD8FE34-C321-49DB-94CF-7006C9882315}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="61_create_fact_reviews"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;&#xA;-- =============================================&#xA;-- i am creating the fact_reviews table&#xA;-- =============================================&#xA;&#xA;IF OBJECT_ID('gold.fact_reviews', 'U') IS NOT NULL&#xA;    DROP TABLE [gold].[fact_reviews];&#xA;&#xA;&#xA;CREATE TABLE [gold].[fact_reviews]&#xA;(&#xA;    review_key BIGINT IDENTITY(1,1) NOT NULL,&#xA;&#xA;    review_id VARCHAR(50) NOT NULL,&#xA;    order_id VARCHAR(50) NOT NULL,&#xA;&#xA;    customer_key INT NOT NULL,&#xA;    date_key INT NOT NULL,&#xA;&#xA;    review_score TINYINT NULL,&#xA;&#xA;    review_comment_title NVARCHAR(MAX) NULL,&#xA;    review_comment_message NVARCHAR(MAX) NULL,&#xA;&#xA;    review_creation_date DATETIME2 NULL,&#xA;    review_answer_timestamp DATETIME2 NULL,&#xA;&#xA;    CONSTRAINT PK_fact_reviews&#xA;        PRIMARY KEY CLUSTERED (review_key),&#xA;&#xA;    CONSTRAINT FK_fact_reviews_dim_customer&#xA;        FOREIGN KEY (customer_key)&#xA;        REFERENCES [gold].[dim_customer](customer_key),&#xA;&#xA;    CONSTRAINT FK_fact_reviews_dim_date&#xA;        FOREIGN KEY (date_key)&#xA;        REFERENCES [gold].[dim_date](date_key)&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
