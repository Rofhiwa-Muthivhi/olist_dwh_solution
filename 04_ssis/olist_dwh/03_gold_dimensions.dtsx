                  synchronousInputId="Package\52_load_dim_sellers\Derived Column.Inputs[Derived Column Input]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\52_load_dim_sellers\Derived Column.Outputs[Derived Column Output].Columns[geography_key]"
                      dataType="i4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\52_load_dim_sellers\Derived Column.Outputs[Derived Column Output].Columns[geography_key]"
