    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\45_create_dim_date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{06466809-3891-4A43-ACBA-01DE8E239628}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="45_create_dim_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;&#xA;-- ============================================================&#xA;-- i am creating the date dimension table in the gold layer&#xA;-- this table will provide calendar attributes for analysing&#xA;-- sales, payments, reviews and delivery performance&#xA;-- ============================================================&#xA;&#xA;IF OBJECT_ID('[gold].[dim_date]', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [gold].[dim_date]&#xA;    (&#xA;        date_key INT NOT NULL,&#xA;        full_date DATE NULL,&#xA;        day_of_month TINYINT NULL,&#xA;        day_of_week_number TINYINT NULL,&#xA;        day_name NVARCHAR(10) NULL,&#xA;        week_of_year TINYINT NULL,&#xA;        month_number TINYINT NULL,&#xA;        month_name NVARCHAR(10) NULL,&#xA;        quarter_number TINYINT NULL,&#xA;        year_number SMALLINT NULL,&#xA;        is_weekend BIT NULL,&#xA;&#xA;        CONSTRAINT PK_dim_date&#xA;            PRIMARY KEY (date_key),&#xA;&#xA;        CONSTRAINT UQ_dim_date_full_date&#xA;            UNIQUE (full_date)&#xA;    );&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\46_load_dim_date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3B016F97-61FC-4DC4-86C1-347CECDEF833}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="46_load_dim_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;&#xA;-- ============================================================&#xA;-- populate the date dimension&#xA;-- ============================================================&#xA;-- i am populating the date dimension with calendar dates&#xA;-- from 01 january 2016 to 31 december 2019.&#xA;-- the calendar dates are generated using a recursive cte,&#xA;-- with additional date attributes derived using sql functions.&#xA;-- ============================================================&#xA;&#xA;SET DATEFIRST 1;&#xA;&#xA;;WITH date_series AS&#xA;(&#xA;    -- generate the first calendar date&#xA;    SELECT CAST('20160101' AS DATE) AS full_date&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- generate the next date until 31 december 2019&#xA;    SELECT DATEADD(DAY, 1, full_date)&#xA;    FROM date_series&#xA;    WHERE full_date &lt; '20191231'&#xA;)&#xA;&#xA;-- insert the generated dates and their calendar attributes&#xA;INSERT INTO [gold].[dim_date]&#xA;(&#xA;    date_key,&#xA;    full_date,&#xA;    day_of_month,&#xA;    day_of_week_number,&#xA;    day_name,&#xA;    week_of_year,&#xA;    month_number,&#xA;    month_name,&#xA;    quarter_number,&#xA;    year_number,&#xA;    is_weekend&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, CONVERT(CHAR(8), ds.full_date, 112)) AS date_key,&#xA;    ds.full_date,&#xA;    DAY(ds.full_date) AS day_of_month,&#xA;    DATEPART(WEEKDAY, ds.full_date) AS day_of_week_number,&#xA;    DATENAME(WEEKDAY, ds.full_date) AS day_name,&#xA;    DATEPART(ISO_WEEK, ds.full_date) AS week_of_year,&#xA;    MONTH(ds.full_date) AS month_number,&#xA;    DATENAME(MONTH, ds.full_date) AS month_name,&#xA;    DATEPART(QUARTER, ds.full_date) AS quarter_number,&#xA;    YEAR(ds.full_date) AS year_number,&#xA;&#xA;    CASE&#xA;        WHEN DATEPART(WEEKDAY, ds.full_date) IN (6, 7)&#xA;            THEN 1&#xA;        ELSE 0&#xA;    END AS is_weekend&#xA;&#xA;FROM date_series AS ds&#xA;WHERE NOT EXISTS&#xA;(&#xA;    -- prevent inserting dates that already exist&#xA;    SELECT 1&#xA;    FROM [gold].[dim_date] AS d&#xA;    WHERE d.date_key = CONVERT(INT, CONVERT(CHAR(8), ds.full_date, 112))&#xA;)&#xA;OPTION (MAXRECURSION 0);&#xA;&#xA;&#xA;&#xA;-- ============================================================&#xA;-- insert the unknown date record&#xA;-- ============================================================&#xA;-- this record will be used when a date is missing or cannot&#xA;-- be matched during the loading of the fact tables.&#xA;-- using -1 ensures that fact records can still be linked to&#xA;-- the date dimension without leaving the foreign key empty.&#xA;-- ============================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [gold].[dim_date]&#xA;    WHERE date_key = -1&#xA;)&#xA;BEGIN&#xA;    INSERT INTO [gold].[dim_date]&#xA;    (&#xA;        date_key,&#xA;        full_date,&#xA;        day_of_month,&#xA;        day_of_week_number,&#xA;        day_name,&#xA;        week_of_year,&#xA;        month_number,&#xA;        month_name,&#xA;        quarter_number,&#xA;        year_number,&#xA;        is_weekend&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        -1,&#xA;        NULL,&#xA;        NULL,&#xA;        NULL,&#xA;        'Unknown',&#xA;        NULL,&#xA;        NULL,&#xA;        'Unknown',&#xA;        NULL,&#xA;        NULL,&#xA;        NULL&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\47_create_dim_customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2DF7A268-3E08-4A46-A6B8-9AD156C50A3E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="47_create_dim_customers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="&#xA;USE [olist_dwh];&#xA;&#xA;&#xA;--===========================================================================================&#xA;-- i am creating the customer dimension in the gold schema.&#xA;-- customer_key will be the surrogate key generated by sql server.&#xA;-- customer_unique_id will remain the business key used to identify each customer.&#xA;-- city and state will be tracked to preserve historical changes using scd type 2.&#xA;-- the valid_from, valid_to and is_current columns will help me manage each customer version.&#xA;--===========================================================================================&#xA;&#xA;IF OBJECT_ID('[gold].[dim_customer]', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [gold].[dim_customer]&#xA;    (&#xA;        customer_key INT IDENTITY(1,1) NOT NULL,&#xA;        customer_unique_id VARCHAR(50) NOT NULL,&#xA;        customer_zip_code_prefix CHAR(5) NULL,&#xA;        customer_city NVARCHAR(255) NULL,&#xA;        customer_state NVARCHAR(255) NULL,&#xA;        valid_from DATETIME2(7) NULL,&#xA;        valid_to DATETIME2(7) NULL,&#xA;        is_current BIT NOT NULL,&#xA;&#xA;        CONSTRAINT PK_dim_customer&#xA;            PRIMARY KEY (customer_key)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;--========================================================================&#xA;-- i am creating a filtered unique index to ensure that each customer&#xA;-- can only have one current record in the dimension.&#xA;-- historical records are still allowed because they have is_current = 0.&#xA;-- this helps prevent duplicate current versions for the same customer.&#xA;--========================================================================&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.indexes&#xA;    WHERE name = 'UX_dim_customer_current'&#xA;      AND object_id = OBJECT_ID('[gold].[dim_customer]')&#xA;)&#xA;BEGIN&#xA;    CREATE UNIQUE NONCLUSTERED INDEX UX_dim_customer_current&#xA;    ON [gold].[dim_customer] (customer_unique_id)&#xA;    WHERE is_current = 1;&#xA;END;&#xA;&#xA;&#xA;--================================================================================&#xA;-- i am inserting an unknown customer record with customer_key = -1.&#xA;-- this record will be used when a customer from a fact table&#xA;-- cannot be matched to a record in the customer dimension.&#xA;-- identity_insert allows me to insert -1 manually instead of&#xA;-- allowing sql server to generate the identity value automatically.&#xA;-- the if not exists check prevents the unknown record from being inserted again.&#xA;--================================================================================&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [gold].[dim_customer]&#xA;    WHERE customer_key = -1&#xA;)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT [gold].[dim_customer] ON;&#xA;&#xA;    INSERT INTO [gold].[dim_customer]&#xA;    (&#xA;        customer_key,&#xA;        customer_unique_id,&#xA;        customer_zip_code_prefix,&#xA;        customer_city,&#xA;        customer_state,&#xA;        valid_from,&#xA;        valid_to,&#xA;        is_current&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        -1,&#xA;        'Unknown',&#xA;        NULL,&#xA;        'Unknown',&#xA;        'Unknown',&#xA;        NULL,&#xA;        NULL,&#xA;        1&#xA;    );&#xA;&#xA;    SET IDENTITY_INSERT [gold].[dim_customer] OFF;&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\48_load_dim_customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{61CE67C7-5C05-4AFE-9268-19A47CC2AFD4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="48_load_dim_customers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;&#xA;--================================================================================&#xA;-- i am implementing an incremental scd type 2 load for the customer dimension.&#xA;-- i am using customer_unique_id as the business key to identify each customer.&#xA;-- i am joining customers to orders to establish the chronological order of&#xA;-- customer location records using the order purchase timestamp.&#xA;-- i will track changes in zip code, city and state while preserving history.&#xA;-- this process will identify new versions without duplicating existing records.&#xA;--================================================================================&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;&#xA;--================================================================================&#xA;-- i am checking that the unknown customer record exists before processing.&#xA;-- this ensures that missing customer information can still be handled.&#xA;--================================================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [gold].[dim_customer]&#xA;    WHERE customer_key = -1&#xA;)&#xA;BEGIN&#xA;    THROW 50001, 'the unknown customer record is missing.', 1;&#xA;END;&#xA;&#xA;&#xA;BEGIN TRY&#xA;&#xA;    BEGIN TRANSACTION;&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am retrieving customer records and joining them to orders.&#xA;    -- i am using the first order purchase timestamp associated with each&#xA;    -- customer record to establish when that location was first observed.&#xA;    --================================================================================&#xA;&#xA;    ;WITH customer_observations AS&#xA;    (&#xA;        SELECT&#xA;            c.customer_unique_id,&#xA;            c.customer_id,&#xA;            c.customer_zip_code_prefix,&#xA;            c.customer_city,&#xA;            c.customer_state,&#xA;&#xA;            MIN(o.order_purchase_timestamp) AS observed_from&#xA;&#xA;        FROM [olist_dwh].[silver].[customers] AS c&#xA;&#xA;        INNER JOIN [olist_dwh].[silver].[orders] AS o&#xA;            ON c.customer_id = o.customer_id&#xA;&#xA;        WHERE c.customer_unique_id IS NOT NULL&#xA;          AND c.customer_unique_id &lt;&gt; 'Unknown'&#xA;&#xA;        GROUP BY&#xA;            c.customer_unique_id,&#xA;            c.customer_id,&#xA;            c.customer_zip_code_prefix,&#xA;            c.customer_city,&#xA;            c.customer_state&#xA;    ),&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am using lag to compare each customer location with the previous&#xA;    -- recorded location to identify changes in customer information.&#xA;    --================================================================================&#xA;&#xA;    customer_location_changes AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_id,&#xA;            customer_zip_code_prefix,&#xA;            customer_city,&#xA;            customer_state,&#xA;            observed_from,&#xA;&#xA;            LAG(customer_id) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_customer_id,&#xA;&#xA;            LAG(customer_zip_code_prefix) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_zip_code,&#xA;&#xA;            LAG(customer_city) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_city,&#xA;&#xA;            LAG(customer_state) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_state&#xA;&#xA;        FROM customer_observations&#xA;    ),&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am keeping the first customer record and subsequent records where&#xA;    -- the zip code, city or state differs from the previous location.&#xA;    -- this prevents unchanged customer information from creating new versions.&#xA;    --================================================================================&#xA;&#xA;    customer_versions AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_id,&#xA;            customer_zip_code_prefix,&#xA;            customer_city,&#xA;            customer_state,&#xA;            observed_from&#xA;&#xA;        FROM customer_location_changes&#xA;&#xA;        WHERE previous_customer_id IS NULL&#xA;&#xA;           OR ISNULL(customer_zip_code_prefix, '') &lt;&gt;&#xA;              ISNULL(previous_zip_code, '')&#xA;&#xA;           OR ISNULL(customer_city, '') &lt;&gt;&#xA;              ISNULL(previous_city, '')&#xA;&#xA;           OR ISNULL(customer_state, '') &lt;&gt;&#xA;              ISNULL(previous_state, '')&#xA;    ),&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am using lead to identify when the next customer version begins.&#xA;    -- this allows me to establish the end date of each previous version.&#xA;    -- the latest version will have no end date and will remain current.&#xA;    --================================================================================&#xA;&#xA;    customer_version_dates AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_zip_code_prefix,&#xA;            customer_city,&#xA;            customer_state,&#xA;            observed_from AS valid_from,&#xA;&#xA;            LEAD(observed_from) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS valid_to&#xA;&#xA;        FROM customer_versions&#xA;    )&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am storing the prepared customer versions in a temporary table.&#xA;    -- this allows me to compare the prepared history with the existing gold records.&#xA;    --================================================================================&#xA;&#xA;    SELECT&#xA;        customer_unique_id,&#xA;        customer_zip_code_prefix,&#xA;        customer_city,&#xA;        customer_state,&#xA;        valid_from,&#xA;        valid_to&#xA;&#xA;    INTO #customer_version_dates&#xA;&#xA;    FROM customer_version_dates;&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am updating existing customer records when a newer version is identified.&#xA;    -- the previous record will be expired and marked as no longer current.&#xA;    -- this preserves the existing customer history instead of overwriting it.&#xA;    --================================================================================&#xA;&#xA;    UPDATE target&#xA;&#xA;    SET&#xA;        target.valid_to = source.valid_to,&#xA;&#xA;        target.is_current =&#xA;            CASE&#xA;                WHEN source.valid_to IS NULL THEN 1&#xA;                ELSE 0&#xA;            END&#xA;&#xA;    FROM [gold].[dim_customer] AS target&#xA;&#xA;    INNER JOIN #customer_version_dates AS source&#xA;        ON target.customer_unique_id = source.customer_unique_id&#xA;       AND target.valid_from = source.valid_from&#xA;&#xA;    WHERE target.customer_key &lt;&gt; -1;&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am inserting customer versions that do not already exist in gold.&#xA;    -- the identity column will automatically generate a new surrogate key.&#xA;    -- the not exists check prevents previously loaded versions from being duplicated.&#xA;    --================================================================================&#xA;&#xA;    INSERT INTO [gold].[dim_customer]&#xA;    (&#xA;        customer_unique_id,&#xA;        customer_zip_code_prefix,&#xA;        customer_city,&#xA;        customer_state,&#xA;        valid_from,&#xA;        valid_to,&#xA;        is_current&#xA;    )&#xA;&#xA;    SELECT&#xA;        source.customer_unique_id,&#xA;        source.customer_zip_code_prefix,&#xA;        source.customer_city,&#xA;        source.customer_state,&#xA;        source.valid_from,&#xA;        source.valid_to,&#xA;&#xA;        CASE&#xA;            WHEN source.valid_to IS NULL THEN 1&#xA;            ELSE 0&#xA;        END&#xA;&#xA;    FROM #customer_version_dates AS source&#xA;&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM [gold].[dim_customer] AS target&#xA;&#xA;        WHERE target.customer_unique_id = source.customer_unique_id&#xA;          AND target.valid_from = source.valid_from&#xA;    );&#xA;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;&#xA;    PRINT 'customer dimension incremental scd type 2 load completed successfully.';&#xA;&#xA;&#xA;END TRY&#xA;&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
