    <DTS:Executable
      DTS:refId="Package\49_create_dim_customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2DF7A268-3E08-4A46-A6B8-9AD156C50A3E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="49_create_dim_customers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;&#xA;--===========================================================================================&#xA;-- i am creating the customer dimension in the gold schema.&#xA;-- customer_key will be the surrogate key generated by sql server.&#xA;-- customer_unique_id will remain the business key used to identify each customer.&#xA;-- geography_key will reference the geography dimension using its surrogate key.&#xA;-- city and state will be tracked to preserve historical changes using scd type 2.&#xA;-- the valid_from, valid_to and is_current columns will help me manage each customer version.&#xA;--===========================================================================================&#xA;&#xA;IF OBJECT_ID('[gold].[dim_customer]', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [gold].[dim_customer]&#xA;    (&#xA;        customer_key INT IDENTITY(1,1) NOT NULL,&#xA;        customer_unique_id VARCHAR(50) NOT NULL,&#xA;        geography_key INT NOT NULL,&#xA;        customer_city NVARCHAR(255) NULL,&#xA;        customer_state NVARCHAR(255) NULL,&#xA;        valid_from DATETIME2(7) NULL,&#xA;        valid_to DATETIME2(7) NULL,&#xA;        is_current BIT NOT NULL,&#xA;&#xA;        CONSTRAINT PK_dim_customer&#xA;            PRIMARY KEY (customer_key)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;--========================================================================&#xA;-- i am creating a filtered unique index to ensure that each customer&#xA;-- can only have one current record in the dimension.&#xA;-- historical records are still allowed because they have is_current = 0.&#xA;--========================================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.indexes&#xA;    WHERE name = 'UX_dim_customer_current'&#xA;      AND object_id = OBJECT_ID('[gold].[dim_customer]')&#xA;)&#xA;BEGIN&#xA;    CREATE UNIQUE NONCLUSTERED INDEX UX_dim_customer_current&#xA;    ON gold.dim_customer (customer_unique_id)&#xA;    WHERE is_current = 1;&#xA;END;&#xA;&#xA;&#xA;&#xA;--========================================================================&#xA;-- i am creating a foreign key relationship between the customer&#xA;-- dimension and the geography dimension.&#xA;-- geography_key will allow customers to reference their geographical&#xA;-- information without storing the same geographical details twice.&#xA;--========================================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.foreign_keys&#xA;    WHERE name = 'FK_dim_customer_geography'&#xA;      AND parent_object_id = OBJECT_ID('[gold].[dim_customer]')&#xA;)&#xA;BEGIN&#xA;    ALTER TABLE gold.dim_customer&#xA;&#xA;    ADD CONSTRAINT FK_dim_customer_geography&#xA;&#xA;    FOREIGN KEY (geography_key)&#xA;&#xA;    REFERENCES gold.dim_geography (geography_key);&#xA;END;&#xA;&#xA;&#xA;&#xA;--========================================================================&#xA;-- i am inserting an unknown customer record with customer_key = -1.&#xA;-- geography_key = -1 references the unknown geography record.&#xA;-- this record will be used when a customer cannot be matched.&#xA;-- identity_insert allows me to insert -1 manually.&#xA;-- the if not exists check prevents duplicate unknown records.&#xA;--========================================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM gold.dim_customer&#xA;    WHERE customer_key = -1&#xA;)&#xA;BEGIN&#xA;&#xA;    SET IDENTITY_INSERT gold.dim_customer ON;&#xA;&#xA;    INSERT INTO gold.dim_customer&#xA;    (&#xA;        customer_key,&#xA;        customer_unique_id,&#xA;        geography_key,&#xA;        customer_city,&#xA;        customer_state,&#xA;        valid_from,&#xA;        valid_to,&#xA;        is_current&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        -1,&#xA;        'Unknown',&#xA;        -1,&#xA;        'Unknown',&#xA;        'Unknown',&#xA;        NULL,&#xA;        NULL,&#xA;        1&#xA;    );&#xA;&#xA;    SET IDENTITY_INSERT gold.dim_customer OFF;&#xA;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\50_load_dim_customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{61CE67C7-5C05-4AFE-9268-19A47CC2AFD4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="50_load_dim_customers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="USE [olist_dwh];&#xA;&#xA;&#xA;--================================================================================&#xA;-- i am implementing an incremental scd type 2 load for the customer dimension.&#xA;-- i am using customer_unique_id as the business key to identify each customer.&#xA;-- i am joining customers to orders to establish the chronological order of&#xA;-- customer location records using the order purchase timestamp.&#xA;-- i am retrieving geography_key by matching customer zip prefixes to&#xA;-- the geography dimension.&#xA;-- i will track changes in geography, city and state while preserving history.&#xA;--================================================================================&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;&#xA;--================================================================================&#xA;-- i am checking that the unknown customer and unknown geography records exist.&#xA;-- this ensures that missing customer or geographical information can be handled.&#xA;--================================================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM gold.dim_customer&#xA;    WHERE customer_key = -1&#xA;)&#xA;BEGIN&#xA;    THROW 50001, 'The unknown customer record is missing.', 1;&#xA;END;&#xA;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM gold.dim_geography&#xA;    WHERE geography_key = -1&#xA;)&#xA;BEGIN&#xA;    THROW 50002, 'The unknown geography record is missing.', 1;&#xA;END;&#xA;&#xA;&#xA;BEGIN TRY&#xA;&#xA;    BEGIN TRANSACTION;&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am retrieving customer records and joining them to orders.&#xA;    -- i am also matching customer zip prefixes to the geography dimension&#xA;    -- to retrieve the corresponding geography surrogate key.&#xA;    -- i am using the first order purchase timestamp associated with each&#xA;    -- customer record to establish when that location was first observed.&#xA;    --================================================================================&#xA;&#xA;    ;WITH customer_observations AS&#xA;    (&#xA;        SELECT&#xA;            c.customer_unique_id,&#xA;            c.customer_id,&#xA;            c.customer_zip_code_prefix,&#xA;&#xA;            COALESCE(g.geography_key, -1) AS geography_key,&#xA;&#xA;            c.customer_city,&#xA;            c.customer_state,&#xA;&#xA;            MIN(o.order_purchase_timestamp) AS observed_from&#xA;&#xA;        FROM silver.customers AS c&#xA;&#xA;        INNER JOIN silver.orders AS o&#xA;            ON c.customer_id = o.customer_id&#xA;&#xA;        LEFT JOIN gold.dim_geography AS g&#xA;            ON LTRIM(RTRIM(c.customer_zip_code_prefix))&#xA;             = LTRIM(RTRIM(g.geography_zip_code_prefix))&#xA;&#xA;        WHERE c.customer_unique_id IS NOT NULL&#xA;          AND c.customer_unique_id &lt;&gt; 'Unknown'&#xA;&#xA;        GROUP BY&#xA;            c.customer_unique_id,&#xA;            c.customer_id,&#xA;            c.customer_zip_code_prefix,&#xA;            g.geography_key,&#xA;            c.customer_city,&#xA;            c.customer_state&#xA;    ),&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am using lag to compare each customer location with the previous&#xA;    -- recorded location to identify changes in geographical information.&#xA;    --================================================================================&#xA;&#xA;    customer_location_changes AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_id,&#xA;            customer_zip_code_prefix,&#xA;            geography_key,&#xA;            customer_city,&#xA;            customer_state,&#xA;            observed_from,&#xA;&#xA;            LAG(customer_id) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_customer_id,&#xA;&#xA;            LAG(customer_zip_code_prefix) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_zip_code,&#xA;&#xA;            LAG(geography_key) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_geography_key,&#xA;&#xA;            LAG(customer_city) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_city,&#xA;&#xA;            LAG(customer_state) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS previous_state&#xA;&#xA;        FROM customer_observations&#xA;    ),&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am keeping the first customer record and subsequent records where&#xA;    -- the zip code, geography key, city or state differs from the previous record.&#xA;    -- this prevents unchanged customer information from creating new versions.&#xA;    --================================================================================&#xA;&#xA;    customer_versions AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_id,&#xA;            geography_key,&#xA;            customer_city,&#xA;            customer_state,&#xA;            observed_from&#xA;&#xA;        FROM customer_location_changes&#xA;&#xA;        WHERE previous_customer_id IS NULL&#xA;&#xA;           OR ISNULL(customer_zip_code_prefix, '') &lt;&gt;&#xA;              ISNULL(previous_zip_code, '')&#xA;&#xA;           OR geography_key &lt;&gt; previous_geography_key&#xA;&#xA;           OR ISNULL(customer_city, '') &lt;&gt;&#xA;              ISNULL(previous_city, '')&#xA;&#xA;           OR ISNULL(customer_state, '') &lt;&gt;&#xA;              ISNULL(previous_state, '')&#xA;    ),&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am using lead to identify when the next customer version begins.&#xA;    -- this allows me to establish the end date of each previous version.&#xA;    -- the latest version will have no end date and will remain current.&#xA;    --================================================================================&#xA;&#xA;    customer_version_dates AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_id,&#xA;            geography_key,&#xA;            customer_city,&#xA;            customer_state,&#xA;&#xA;            observed_from AS valid_from,&#xA;&#xA;            LEAD(observed_from) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY observed_from, customer_id&#xA;            ) AS valid_to&#xA;&#xA;        FROM customer_versions&#xA;    )&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am storing the prepared customer versions in a temporary table.&#xA;    -- this allows me to compare the prepared history with existing gold records.&#xA;    --================================================================================&#xA;&#xA;    SELECT&#xA;        customer_unique_id,&#xA;        geography_key,&#xA;        customer_city,&#xA;        customer_state,&#xA;        valid_from,&#xA;        valid_to&#xA;&#xA;    INTO #customer_version_dates&#xA;&#xA;    FROM customer_version_dates;&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am updating existing customer records when a matching version exists.&#xA;    -- i am updating the geography reference and maintaining the correct&#xA;    -- valid_from, valid_to and is_current values.&#xA;    -- this preserves existing customer history instead of overwriting it.&#xA;    --================================================================================&#xA;&#xA;    UPDATE target&#xA;&#xA;    SET&#xA;        target.geography_key = source.geography_key,&#xA;        target.customer_city = source.customer_city,&#xA;        target.customer_state = source.customer_state,&#xA;        target.valid_to = source.valid_to,&#xA;&#xA;        target.is_current =&#xA;            CASE&#xA;                WHEN source.valid_to IS NULL THEN 1&#xA;                ELSE 0&#xA;            END&#xA;&#xA;    FROM gold.dim_customer AS target&#xA;&#xA;    INNER JOIN #customer_version_dates AS source&#xA;        ON target.customer_unique_id = source.customer_unique_id&#xA;       AND target.valid_from = source.valid_from&#xA;&#xA;    WHERE target.customer_key &lt;&gt; -1;&#xA;&#xA;&#xA;    --================================================================================&#xA;    -- i am inserting customer versions that do not already exist in gold.&#xA;    -- the identity column will automatically generate a new surrogate key.&#xA;    -- geography_key will reference the geography dimension.&#xA;    -- the not exists check prevents previously loaded versions from being duplicated.&#xA;    --================================================================================&#xA;&#xA;    INSERT INTO gold.dim_customer&#xA;    (&#xA;        customer_unique_id,&#xA;        geography_key,&#xA;        customer_city,&#xA;        customer_state,&#xA;        valid_from,&#xA;        valid_to,&#xA;        is_current&#xA;    )&#xA;&#xA;    SELECT&#xA;        source.customer_unique_id,&#xA;        source.geography_key,&#xA;        source.customer_city,&#xA;        source.customer_state,&#xA;        source.valid_from,&#xA;        source.valid_to,&#xA;&#xA;        CASE&#xA;            WHEN source.valid_to IS NULL THEN 1&#xA;            ELSE 0&#xA;        END&#xA;&#xA;    FROM #customer_version_dates AS source&#xA;&#xA;    WHERE NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM gold.dim_customer AS target&#xA;&#xA;        WHERE target.customer_unique_id = source.customer_unique_id&#xA;          AND target.valid_from = source.valid_from&#xA;    );&#xA;&#xA;&#xA;    DROP TABLE #customer_version_dates;&#xA;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;&#xA;    PRINT 'Customer dimension incremental SCD Type 2 load completed successfully.';&#xA;&#xA;&#xA;END TRY&#xA;&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\51_create_dim_sellers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E2F9154A-6A4E-4BDB-8266-EA80F575B572}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="51_create_dim_sellers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="&#xA;USE [olist_dwh];&#xA;&#xA;--=========================================================&#xA;-- 1. CREATE SELLER DIMENSION TABLE&#xA;--=========================================================&#xA;&#xA;IF OBJECT_ID('gold.dim_seller', 'U') IS NULL&#xA;BEGIN&#xA;&#xA;    CREATE TABLE gold.dim_seller&#xA;    (&#xA;        seller_key INT IDENTITY(1,1) NOT NULL,&#xA;        seller_id VARCHAR(50) NOT NULL,&#xA;        geography_key INT NOT NULL,&#xA;        seller_city NVARCHAR(255) NOT NULL,&#xA;        seller_state NVARCHAR(255) NOT NULL,&#xA;&#xA;        CONSTRAINT PK_dim_seller&#xA;            PRIMARY KEY CLUSTERED (seller_key)&#xA;    );&#xA;&#xA;END;&#xA;&#xA;&#xA;--=========================================================&#xA;-- 2. CREATE UNIQUE INDEX ON SELLER BUSINESS KEY&#xA;--=========================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.indexes&#xA;    WHERE name = 'UX_dim_seller_seller_id'&#xA;      AND object_id = OBJECT_ID('gold.dim_seller')&#xA;)&#xA;BEGIN&#xA;&#xA;    CREATE UNIQUE NONCLUSTERED INDEX UX_dim_seller_seller_id&#xA;    ON gold.dim_seller (seller_id);&#xA;&#xA;END;&#xA;&#xA;&#xA;--=========================================================&#xA;-- 3. CREATE GEOGRAPHY FOREIGN KEY&#xA;--=========================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.foreign_keys&#xA;    WHERE name = 'FK_dim_seller_geography'&#xA;      AND parent_object_id = OBJECT_ID('gold.dim_seller')&#xA;)&#xA;BEGIN&#xA;&#xA;    ALTER TABLE gold.dim_seller&#xA;    ADD CONSTRAINT FK_dim_seller_geography&#xA;    FOREIGN KEY (geography_key)&#xA;    REFERENCES gold.dim_geography (geography_key);&#xA;&#xA;END;&#xA;&#xA;&#xA;--=========================================================&#xA;-- 4. INSERT UNKNOWN SELLER RECORD&#xA;--=========================================================&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM gold.dim_seller&#xA;    WHERE seller_key = -1&#xA;       OR seller_id = 'Unknown'&#xA;)&#xA;BEGIN&#xA;&#xA;    SET IDENTITY_INSERT gold.dim_seller ON;&#xA;&#xA;    INSERT INTO gold.dim_seller&#xA;    (&#xA;        seller_key,&#xA;        seller_id,&#xA;        geography_key,&#xA;        seller_city,&#xA;        seller_state&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        -1,&#xA;        'Unknown',&#xA;        -1,&#xA;        'Unknown',&#xA;        'Unknown'&#xA;    );&#xA;&#xA;    SET IDENTITY_INSERT gold.dim_seller OFF;&#xA;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
