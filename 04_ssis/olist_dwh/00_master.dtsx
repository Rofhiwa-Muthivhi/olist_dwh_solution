      DTS:ObjectName="01_create_stg_dwh_db"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{348E272A-82DB-4566-B388-E40BF3736DD4}"
          SQLTask:SqlStatementSource="&#xA;-- create staging and data warehouse databases&#xA;-- use IF DB_ID to check if the databases already exist and avoid errors when rerunning the script&#xA;&#xA;IF DB_ID('olist_stg') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE olist_stg;&#xA;END;&#xA;&#xA;IF DB_ID('olist_dwh') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE olist_dwh;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02_create_schemas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FB72D027-88A4-47EB-B79A-5C3E270451C1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02_create_schemas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{348E272A-82DB-4566-B388-E40BF3736DD4}"
          SQLTask:SqlStatementSource="&#xA;-- create schemas&#xA;-- use IF SCHEMA_ID to check if the schemas already exist and avoid errors when rerunning the script&#xA;&#xA;-- create bronze schema in the staging database&#xA;USE olist_stg;&#xA;&#xA;IF SCHEMA_ID('bronze') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;END;&#xA;&#xA;-- create silver and gold schemas in the data warehouse database&#xA;USE olist_dwh;&#xA;&#xA;IF SCHEMA_ID('silver') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA silver');&#xA;END;&#xA;&#xA;IF SCHEMA_ID('gold') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA gold');&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
