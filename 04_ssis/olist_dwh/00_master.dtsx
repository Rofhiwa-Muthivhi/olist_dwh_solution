    <DTS:Executable
      DTS:refId="Package\01_create_stg_dwh_db"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{12D3720F-7D17-4282-A4CE-C56568D41476}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01_create_stg_dwh_db"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{348E272A-82DB-4566-B388-E40BF3736DD4}"
          SQLTask:SqlStatementSource="&#xA;-- create staging and data warehouse databases&#xA;-- use IF DB_ID to check if the databases already exist and avoid errors when rerunning the script&#xA;&#xA;IF DB_ID('olist_stg') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE olist_stg;&#xA;END;&#xA;&#xA;IF DB_ID('olist_dwh') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE olist_dwh;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02_create_schemas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FB72D027-88A4-47EB-B79A-5C3E270451C1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02_create_schemas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{348E272A-82DB-4566-B388-E40BF3736DD4}"
          SQLTask:SqlStatementSource="&#xA;-- create schemas&#xA;-- use IF SCHEMA_ID to check if the schemas already exist and avoid errors when rerunning the script&#xA;&#xA;-- create bronze schema in the staging database&#xA;USE olist_stg;&#xA;&#xA;IF SCHEMA_ID('bronze') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;END;&#xA;&#xA;-- create silver and gold schemas in the data warehouse database&#xA;USE olist_dwh;&#xA;&#xA;IF SCHEMA_ID('silver') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA silver');&#xA;END;&#xA;&#xA;IF SCHEMA_ID('gold') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA gold');&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03_create_batch_log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{72504DD0-0A18-4239-BAAF-277B2B8ED718}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03_create_batch_log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{348E272A-82DB-4566-B388-E40BF3736DD4}"
          SQLTask:SqlStatementSource="-- create master batch log table&#xA;&#xA;IF OBJECT_ID('olist_dwh.etl.batch_log', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE olist_dwh.etl.batch_log&#xA;    (&#xA;        batch_id INT NOT NULL,&#xA;&#xA;        start_ts DATETIME2 NOT NULL&#xA;            CONSTRAINT DF_batch_log_start_ts&#xA;            DEFAULT SYSDATETIME(),&#xA;&#xA;        end_ts DATETIME2 NULL,&#xA;&#xA;        status NVARCHAR(20) NOT NULL,&#xA;&#xA;        CONSTRAINT PK_batch_log&#xA;            PRIMARY KEY (batch_id)&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04_create_load_log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3A4E1762-036F-4DC2-BB76-7C7597BFA2E4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04_create_load_log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{348E272A-82DB-4566-B388-E40BF3736DD4}"
          SQLTask:SqlStatementSource="&#xA;-- create central etl load log table&#xA;&#xA;&#xA;IF OBJECT_ID('olist_dwh.etl.load_log', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE olist_dwh.etl.load_log&#xA;    (&#xA;        load_log_id INT IDENTITY(1,1) NOT NULL,&#xA;&#xA;        batch_id INT NOT NULL,&#xA;&#xA;        package NVARCHAR(100) NOT NULL,&#xA;&#xA;        table_name NVARCHAR(128) NOT NULL,&#xA;&#xA;        rows_read INT NOT NULL DEFAULT 0,&#xA;&#xA;        rows_written INT NOT NULL DEFAULT 0,&#xA;&#xA;        rows_error INT NOT NULL DEFAULT 0,&#xA;&#xA;        ts DATETIME2 NOT NULL&#xA;            DEFAULT SYSDATETIME(),&#xA;&#xA;        CONSTRAINT PK_load_log&#xA;            PRIMARY KEY (load_log_id)&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\05_initialize_etl_batch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C44D323D-59A6-4BA4-9A2B-1098D054C67B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05_initialize_etl_batch"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{310CC007-85DA-4340-BD2B-8E52234DCCD9}"
          SQLTask:SqlStatementSource="-- initialize a new etl batch&#xA;&#xA;DECLARE @batch_id INT;&#xA;&#xA;-- generate the next batch id&#xA;SELECT @batch_id = NEXT VALUE FOR etl.batch_id_seq;&#xA;&#xA;-- insert the batch execution record&#xA;INSERT INTO etl.batch_log&#xA;(&#xA;    batch_id,&#xA;    start_ts,&#xA;    end_ts,&#xA;    status&#xA;)&#xA;VALUES&#xA;(&#xA;    @batch_id,&#xA;    SYSDATETIME(),&#xA;    NULL,&#xA;    'RUNNING'&#xA;);&#xA;&#xA;-- return the generated batch id to ssis&#xA;SELECT @batch_id AS BatchID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
